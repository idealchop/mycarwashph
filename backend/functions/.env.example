# Copy to backend/functions/.env.local for the emulator, or .env.<project-id>
# (e.g. .env.mycarwash-dev) for deploys. Never commit real values.

# Comma-separated web origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Pepper mixed into River Mobile API key hashes (placeholder auth for /v1).
# In production, store a long random value in Secret Manager instead.
API_KEY_PEPPER=change-me-local-only
