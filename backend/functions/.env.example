# Optional overrides for local runs. Never commit real values.
# Copy to backend/functions/.env.local for the emulator.

# Comma-separated web origins allowed by CORS. Defaults per environment live in
# src/config/environments.ts (App Hosting URL, mycarwash.ph, localhost for dev).
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Emulator only: pepper for /v1 API key hashes. Deployed functions read the
# Secret Manager secrets API_KEY_PEPPER_DEV / API_KEY_PEPPER_PROD instead.
API_KEY_PEPPER=local-dev-pepper

# Plan gating: "1" enforces Partner limits (10 walk-ins/day, 10 companion questions/month,
# Pro-only tools, Paid-only routes); anything else (default) unlocks every feature for all plans.
# Hosted dev and prod are both 0 (all features unlocked for testing, decision of Oct 15, 2026).
# Deployed functions get it from an untracked backend/functions/.env.mycarwashph at deploy time
# (see docs/environments.md); unset also means off.
PLAN_GATING_ENABLED=0
