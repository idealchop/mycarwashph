# Copy to frontend/.env.local. Never commit real values.
# Firebase web config is public by design but still per-environment; use your
# mycarwash-dev / mycarwash-prod web app values. Placeholders work with emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mycarwash.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-mycarwash
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# true = connect to local emulators (auth 9099, firestore 8080, functions 5001)
NEXT_PUBLIC_USE_EMULATORS=true

# Base URL of the mycarwashApi function (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/demo-mycarwash/asia-southeast1/mycarwashApi

# Auth emulator URL (only used when NEXT_PUBLIC_USE_EMULATORS=true)
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099
