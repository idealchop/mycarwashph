# Copy to frontend/.env.local. Never commit real values.
#
# Local development uses the emulators by default (offline demo project
# `demo-mycarwash`), so nothing below is required to run `pnpm dev`.
#
# To point a local build at the real project `mycarwashph` instead, fill in the
# public web config of the "Mycarwash PH Web" app (Firebase console > Project
# settings > Your apps) and set NEXT_PUBLIC_USE_EMULATORS=false. On App Hosting
# these come from FIREBASE_WEBAPP_CONFIG automatically (see next.config.ts).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=mycarwashph.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=mycarwashph
# NEXT_PUBLIC_FIREBASE_APP_ID=

# true = connect to local emulators (auth 9099); false = real Firebase Auth
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Environment label and API base URL (shop API function for that environment).
# Emulator: http://127.0.0.1:5001/demo-mycarwash/asia-southeast1/mycarwashApiDev
# Dev:      https://asia-southeast1-mycarwashph.cloudfunctions.net/mycarwashApiDev
# Prod:     https://asia-southeast1-mycarwashph.cloudfunctions.net/mycarwashApiProd
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5001/demo-mycarwash/asia-southeast1/mycarwashApiDev
