{
  "name": "@river-apps/icons",
  "version": "0.1.0",
  "private": true,
  "description": "River Apps UI Kit 3D-style illustrations, icons and avatars as React components and raw SVG.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./svg/*": "./svg/*"
  },
  "files": ["dist", "svg"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "react": "^19.0.0" },
  "devDependencies": { "@types/react": "19.2.18", "react": "19.2.8", "typescript": "5.9.3" }
}
