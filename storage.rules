rules_version = '2';
// Mycarwash.ph shop photos for River Mobile listing.
// Path: businesses/{businessId}/photos/{fileName}
// Storage rules cannot read named Firestore databases (mycarwash-dev / mycarwash-prod),
// so uploads/deletes go through the shop API (owner check there, Admin SDK write).
// Clients may only read shop photos.
service firebase.storage {
  match /b/{bucket}/o {
    match /businesses/{businessId}/photos/{fileName} {
      // Public read so River Mobile can show storefront photos from download URLs.
      allow read: if true;
      allow write: if false;
    }

    // Everything else is closed.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
